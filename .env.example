# Database (Docker)
POSTGRES_USER=fixli
POSTGRES_PASSWORD=fixli_secret
POSTGRES_DB=fixli

# API
DATABASE_URL="postgresql://fixli:fixli_secret@localhost:5432/fixli?schema=public"
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3002
NODE_ENV="development"
LOG_LEVEL="info"

# Gemini AI
GEMINI_API_KEY=""

# pgAdmin
PGADMIN_EMAIL=admin@fixli.dev
PGADMIN_PASSWORD=admin

# Mobile App
EXPO_PUBLIC_API_URL="http://localhost:3002/api"
