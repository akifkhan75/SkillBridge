# Database (Docker)
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_secret
POSTGRES_DB=skillbridge

# API
DATABASE_URL="postgresql://skillbridge:skillbridge_secret@localhost:5432/skillbridge?schema=public"
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3002
NODE_ENV="development"
LOG_LEVEL="info"

# Gemini AI
GEMINI_API_KEY=""

# pgAdmin
PGADMIN_EMAIL=admin@skillbridge.dev
PGADMIN_PASSWORD=admin

# Mobile App
EXPO_PUBLIC_API_URL="http://localhost:3002/api"
