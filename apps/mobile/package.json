{
  "name": "@skillbridge/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo 'Mobile build handled by EAS'",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf .expo node_modules"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-navigation/drawer": "^7.5.5",
    "@react-navigation/native": "^7.1.16",
    "@reduxjs/toolkit": "^2.8.2",
    "@skillbridge/shared": "workspace:*",
    "axios": "^1.7.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "^57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lottie-react-native": "7.3.8",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-masked-text": "^1.13.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "~15.15.4",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "18.3.1",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!.*((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@reduxjs/toolkit|immer|@skillbridge/shared))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/App.tsx",
      "!src/navigation/**",
      "!src/theme/**"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
