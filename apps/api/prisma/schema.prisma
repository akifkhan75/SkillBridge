generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  customer
  worker
  admin
}

enum JobStatus {
  CREATED
  MATCHES_FOUND
  AWAITING_WORKER
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ActivationStatus {
  /// Signed up, still completing their profile and documents.
  ONBOARDING
  /// Submitted; waiting for an admin.
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
}

enum Gender {
  FEMALE
  MALE
}

enum PricingModel {
  FIXED
  HOURLY
  CALLOUT_PLUS_QUOTE
  QUOTE
}

enum VerificationType {
  ID
  SELFIE
  TRADE_LICENSE
  INSURANCE
}

enum VerificationCaseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum UploadPurpose {
  AVATAR
  VERIFICATION
  PORTFOLIO
  JOB_PHOTO
  JOB_AUDIO
}

enum MediaKind {
  PHOTO
  AUDIO
}

enum UploadStatus {
  PENDING
  READY
  REJECTED
}

model User {
  id                  String     @id @default(cuid())
  /// Required for admins; optional for customers/workers, who sign in with their phone.
  email               String?    @unique
  /// E.164 (+923001234567). Required for customers/workers.
  phone               String?    @unique
  countryCode         String?
  locale              String     @default("en")
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  name                String
  password            String
  type                UserType
  profileImageUrl     String?
  pushToken           String? // Push notification token
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  failedLoginAttempts Int        @default(0)
  lockoutUntil        DateTime?

  worker           Worker?
  addresses        Address[]
  jobRequests      JobRequest[]
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  chatThreads      ChatThread[]
  reviewsGiven     Review[]      @relation("ReviewsGiven")
  reviewsReceived  Review[]      @relation("ReviewsReceived")
  disputesRaised   Dispute[]     @relation("DisputesRaised")
  properties       Property[]
  Session          Session[]

  @@index([email])
}

model Address {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String? // e.g., "Home", "Work"
  streetAddress  String
  city           String
  /// Neighbourhood / sector, e.g. "Gulshan-e-Iqbal Block 13"
  area           String?
  /// Free text that helps a worker find the door ("opposite the mosque")
  landmark       String?
  /// Flat / floor / building
  buildingDetail String?
  state          String?
  /// ISO 3166-1 alpha-2, e.g. PK
  country        String
  postalCode     String?
  latitude       Float?
  longitude      Float?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  jobs           JobRequest[]

  @@index([userId])
}

model ServiceCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  iconName     String?
  sortOrder    Int      @default(0)
  /// {"ur":{"name":"...","description":"..."},"ar":{...}}
  translations Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  issues        ServiceIssue[]
  services      Service[]
  workers       WorkerService[]
  packages      ServicePackage[]
  subscriptions SubscriptionPlan[]
  jobs          JobRequest[]
}

model Service {
  id           String          @id @default(cuid())
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  basePrice    Int?
  currency     String          @default("USD")
  sortOrder    Int             @default(0)
  translations Json?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  jobRequests   JobRequest[]
  recurringJobs RecurringJob[]
}

model Worker {
  id                   String           @id
  user                 User             @relation(fields: [id], references: [id], onDelete: Cascade)
  rating               Float            @default(0)
  /// Derived from approved VerificationCases; never set by the worker.
  isVerified           Boolean          @default(false)
  bio                  String?
  experienceYears      Int              @default(0)
  languages            String[]
  gender               Gender?
  /// Show initials instead of the photo until a customer has booked this worker.
  hidePhotoUntilBooked Boolean          @default(false)
  hasInsurance         Boolean          @default(false)
  equipment            String[]
  isOnline             Boolean          @default(false)
  /// Centre of the area the worker serves (their base), plus a label like "Gulshan-e-Iqbal, Karachi".
  serviceLat           Float?
  serviceLng           Float?
  serviceAreaLabel     String?
  serviceRadius        Int              @default(10)
  pricingModel         PricingModel?
  /// Integer minor units in `currency`.
  minimumCallOutFee    Int?
  hourlyRate           Int?
  currency             String           @default("PKR")
  timezone             String           @default("Asia/Karachi")
  activationStatus     ActivationStatus @default(ONBOARDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  services      WorkerService[]
  assignedJobs  JobRequest[]
  matches       JobMatch[]
  offers        Offer[]
  workingHours  WorkingHours[]
  portfolio     PortfolioItem[]
  verifications VerificationCase[]

  @@index([activationStatus])
}

model WorkingHours {
  id          String @id @default(cuid())
  workerId    String
  worker      Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// 0 = Sunday ... 6 = Saturday
  weekday     Int
  /// Minutes after midnight, local to Worker.timezone
  startMinute Int
  endMinute   Int

  @@unique([workerId, weekday])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  workerId    String
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Object-storage keys (public-read bucket path).
  photoKeys   String[]
  createdAt   DateTime @default(now())

  @@index([workerId])
}

model VerificationCase {
  id           String                 @id @default(cuid())
  workerId     String
  worker       Worker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type         VerificationType
  status       VerificationCaseStatus @default(SUBMITTED)
  /// Private object-storage keys; only the worker and admins can read them (signed URLs).
  documentKeys String[]
  /// ID number etc. entered by the worker, shown to the reviewer. Stored masked in the UI.
  reference    String?
  reviewerId   String?
  reviewedAt   DateTime?
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime               @default(now())

  @@index([workerId, type])
  @@index([status, createdAt])
}

model Upload {
  id        String        @id @default(cuid())
  ownerId   String
  purpose   UploadPurpose
  key       String        @unique
  mime      String
  /// Size the client declared when asking for the upload slot; enforced on receipt.
  size      Int
  status    UploadStatus  @default(PENDING)
  createdAt DateTime      @default(now())
  readyAt   DateTime?
  /// Set once the upload is attached to something, so it cannot be reused elsewhere.
  usedAt    DateTime?

  @@index([ownerId, status])
}

model ServiceIssue {
  id           String          @id @default(cuid())
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Stable key, e.g. "leaking_tap"
  code         String
  name         String
  translations Json?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)

  @@unique([categoryId, code])
}

model WorkerService {
  workerId   String
  categoryId String
  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
}

model JobRequest {
  id                String           @id @default(cuid())
  customerId        String
  customer          User             @relation(fields: [customerId], references: [id])
  customerName      String
  description       String
  serviceId         String?
  service           Service?         @relation(fields: [serviceId], references: [id])
  urgency           String?
  severity          String?
  estimatedDuration String?
  priceEstimate     String?
  status            JobStatus        @default(CREATED)
  location          String?
  requestedDate     String?
  assignedWorkerId  String?
  assignedWorker    Worker?          @relation(fields: [assignedWorkerId], references: [id])
  paymentAmount     Int?
  currency          String           @default("USD")
  paymentDate       DateTime?
  isEmergency       Boolean          @default(false)
  categoryId        String?
  category          ServiceCategory? @relation(fields: [categoryId], references: [id])
  /// Common-problem codes the customer tapped (ServiceIssue.code)
  issueCodes        String[]
  /// Short generated title, e.g. "Leaking tap"
  title             String?
  addressId         String?
  address           Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  /// Snapshot so a later edit to the saved address never changes a job in progress.
  latitude          Float?
  longitude         Float?
  /// Coarse location shown to workers before they are booked (never the exact address).
  area              String?
  city              String?
  /// NOW | TODAY | TOMORROW | SCHEDULED
  whenOption        String?
  scheduledFrom     DateTime?
  scheduledTo       DateTime?
  cancelReason      String?
  cancelledById     String?
  /// Client-generated; the same key from the same customer never creates a second job.
  idempotencyKey    String?
  /// Price the customer accepted (integer minor units of agreedCurrency). Binding once booked.
  agreedAmount      Int?
  agreedCurrency    String?
  acceptedOfferId   String?
  bookedAt          DateTime?
  /// 1 = first search; 2 = widened search after nobody responded.
  matchRound        Int              @default(0)
  lastMatchedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  media        JobMedia[]
  events       JobEvent[]
  matches      JobMatch[]
  offers       Offer[]
  analyses     JobAiAnalysis[]
  chatThreads  ChatThread[]
  evidence     JobEvidence[]
  quotes       Quote[]
  changeOrders ChangeOrder[]
  transactions Transaction[]
  disputes     Dispute[]
  reviews      Review[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@index([status])
  @@index([status, categoryId])
}

model JobMedia {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  kind         MediaKind
  /// Private object-storage key; served only through short-lived signed links.
  storageKey   String
  mime         String
  /// For voice notes: the text the customer saw and confirmed.
  transcript   String?
  createdById  String
  createdAt    DateTime   @default(now())

  @@index([jobRequestId])
}

/// Append-only history of a job; drives the timeline and (Phase 6) realtime events.
model JobEvent {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  actorId      String?
  type         String
  fromStatus   String?
  toStatus     String?
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([jobRequestId, createdAt])
}

/// Every AI call is recorded with its model, prompt/schema version and whether the output was valid (doc 08).
model JobAiAnalysis {
  id            String      @id @default(cuid())
  ownerId       String
  jobRequestId  String?
  jobRequest    JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  kind          String
  provider      String
  model         String
  promptVersion String
  schemaVersion String
  output        Json?
  valid         Boolean
  error         String?
  latencyMs     Int
  createdAt     DateTime    @default(now())

  @@index([ownerId, createdAt])
}

model JobEvidence {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  url          String
  type         String // "BEFORE", "DURING", "AFTER", "RECEIPT"
  notes        String?
  uploadedAt   DateTime   @default(now())
}

model Quote {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  totalAmount  Int
  currency     String     @default("USD")
  details      String?
  status       String     @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ChangeOrder {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  reason       String
  addedScope   String
  revisedPrice Int
  currency     String     @default("USD")
  status       String     @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Review {
  id           String      @id @default(cuid())
  jobRequestId String?
  jobRequest   JobRequest? @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  reviewerId   String
  reviewer     User        @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  targetId     String
  target       User        @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime    @default(now())

  @@unique([jobRequestId, reviewerId])
  @@index([targetId])
}

model Transaction {
  id             String     @id @default(cuid())
  jobRequestId   String
  jobRequest     JobRequest @relation(fields: [jobRequestId], references: [id])
  amount         Int
  currency       String     @default("USD")
  status         String // PENDING, COMPLETED, FAILED, REFUNDED
  stripeChargeId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Dispute {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     User       @relation("DisputesRaised", fields: [raisedById], references: [id])
  reason       String
  description  String?
  status       String     @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, CLOSED
  resolution   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ChatThread {
  id            String      @id @default(cuid())
  jobRequestId  String?
  jobRequest    JobRequest? @relation(fields: [jobRequestId], references: [id])
  lastMessageAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  participants User[]
  messages     ChatMessage[]
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User       @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User       @relation("ReceivedMessages", fields: [receiverId], references: [id])
  text       String
  isRead     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([threadId])
}

model ServicePackage {
  id               String          @id @default(cuid())
  name             String
  description      String?
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  includedFeatures String[]        @default([])
  indicativePrice  String?
  iconName         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model SubscriptionPlan {
  id           String          @id @default(cuid())
  name         String
  description  String?
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  frequency    String?
  pricePerTerm String?
  benefits     String[]        @default([])
  iconName     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Property {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // e.g., "Single Family", "Apartment", "Commercial"
  streetAddress String
  city          String
  state         String?
  country       String
  postalCode    String
  squareFeet    Int?
  builtYear     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets        Asset[]
  recurringJobs RecurringJob[]
}

model Asset {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String // e.g., "HVAC Unit", "Water Heater", "Refrigerator"
  category     String // e.g., "Appliance", "System", "Structural"
  make         String?
  model        String?
  serialNumber String?
  installDate  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warranties Warranty[]
}

model Warranty {
  id              String   @id @default(cuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider        String
  policyNumber    String?
  expirationDate  DateTime
  coverageDetails String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RecurringJob {
  id                String   @id @default(cuid())
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service  @relation(fields: [serviceId], references: [id])
  frequency         String // e.g., "WEEKLY", "MONTHLY", "QUARTERLY", "YEARLY"
  nextExecutionDate DateTime
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Append-only record of sensitive actions (doc 13 "Audit", doc 21 §6.4).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// One row per signed-in device. The refresh token is stored only as a hash and rotates on use.
model Session {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId                 String
  deviceName               String?
  platform                 String?
  refreshTokenHash         String
  /// Hash of the token that was just replaced; presenting it again means it was stolen/replayed.
  previousRefreshTokenHash String?
  createdAt                DateTime  @default(now())
  lastUsedAt               DateTime  @default(now())
  expiresAt                DateTime
  revokedAt                DateTime?

  @@index([userId])
  @@index([userId, deviceId])
}

/// A worker the matching engine chose to tell about a request, with why (doc 06 "matches").
model JobMatch {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  round        Int
  rank         Int
  score        Float
  /// null when the request had no GPS and was matched by city
  distanceKm   Float?
  notifiedAt   DateTime   @default(now())
  /// Worker said "not for me"
  declinedAt   DateTime?

  @@unique([jobRequestId, workerId])
  @@index([workerId, notifiedAt])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// A worker's price for a request. One live offer per worker per job; revising updates it.
model Offer {
  id           String      @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// Integer minor units
  amount       Int
  currency     String
  etaMinutes   Int?
  note         String?
  status       OfferStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([jobRequestId, workerId])
  @@index([jobRequestId, status])
  @@index([status, expiresAt])
}
