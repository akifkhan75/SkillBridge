generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  customer
  worker
  admin
}

enum JobStatus {
  CREATED
  MATCHES_FOUND
  AWAITING_WORKER
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivationStatus {
  ACTIVE
  PENDING_REVIEW
  INACTIVE
}

enum VerificationStatus {
  NONE
  SUBMITTED
  CHECKED
  VERIFIED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  password          String
  type              UserType
  profileImageUrl   String?
  pushToken         String?  // Push notification token
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  failedLoginAttempts Int      @default(0)
  lockoutUntil      DateTime?

  worker            Worker?
  addresses         Address[]
  jobRequests       JobRequest[]
  sentMessages      ChatMessage[] @relation("SentMessages")
  receivedMessages  ChatMessage[] @relation("ReceivedMessages")
  chatThreads       ChatThread[]
  reviewsGiven      Review[] @relation("ReviewsGiven")
  reviewsReceived   Review[] @relation("ReviewsReceived")
  disputesRaised    Dispute[] @relation("DisputesRaised")
  properties        Property[]

  @@index([email])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?  // e.g., "Home", "Work"
  streetAddress String
  city          String
  state         String?
  country       String
  postalCode    String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconName    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    Service[]
  workers     WorkerService[]
  packages    ServicePackage[]
  subscriptions SubscriptionPlan[]
}

model Service {
  id          String   @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  basePrice   Int?
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRequests JobRequest[]
  recurringJobs RecurringJob[]
}

model Worker {
  id                    String            @id
  user                  User              @relation(fields: [id], references: [id], onDelete: Cascade)
  rating                Float             @default(0)
  homeAddress           String?
  availability          String?
  hourlyRateRange       String?
  isVerified            Boolean           @default(false)
  bio                   String?
  experienceYears       Int               @default(0)
  licenseDetails        String?
  isLicenseVerified     Boolean           @default(false)
  hasInsurance          Boolean           @default(false)
  equipment             String[]
  isOnline              Boolean           @default(false)
  serviceRadius         Int               @default(20)
  minimumCallOutFee     Int?
  currency              String            @default("USD")
  activationStatus      ActivationStatus  @default(PENDING_REVIEW)
  idVerifiedStatus      VerificationStatus @default(NONE)
  backgroundCheckStatus VerificationStatus @default(NONE)
  referencesStatus      VerificationStatus @default(NONE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  services              WorkerService[]
  assignedJobs          JobRequest[]

  @@index([activationStatus])
}

model WorkerService {
  workerId    String
  categoryId  String
  worker      Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
}

model JobRequest {
  id                String      @id @default(cuid())
  customerId        String
  customer          User        @relation(fields: [customerId], references: [id])
  customerName      String
  description       String
  serviceId         String?
  service           Service?    @relation(fields: [serviceId], references: [id])
  urgency           String?
  severity          String?
  estimatedDuration String?
  priceEstimate     String?
  status            JobStatus   @default(CREATED)
  location          String?
  requestedDate     String?
  assignedWorkerId  String?
  assignedWorker    Worker?     @relation(fields: [assignedWorkerId], references: [id])
  paymentAmount   Int?
  currency        String      @default("USD")
  paymentDate     DateTime?
  isEmergency       Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  chatThreads       ChatThread[]
  evidence          JobEvidence[]
  quotes            Quote[]
  changeOrders      ChangeOrder[]
  transactions      Transaction[]
  disputes          Dispute[]

  @@index([customerId])
  @@index([status])
}

model JobEvidence {
  id           String      @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  url          String
  type         String      // "BEFORE", "DURING", "AFTER", "RECEIPT"
  notes        String?
  uploadedAt   DateTime    @default(now())
}

model Quote {
  id           String      @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  totalAmount  Int
  currency     String      @default("USD")
  details      String?
  status       String      @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ChangeOrder {
  id           String      @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  reason       String
  addedScope   String
  revisedPrice Int
  currency     String      @default("USD")
  status       String      @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  targetId    String
  target      User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}

model Transaction {
  id           String      @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest  @relation(fields: [jobRequestId], references: [id])
  amount       Int
  currency     String      @default("USD")
  status       String      // PENDING, COMPLETED, FAILED, REFUNDED
  stripeChargeId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Dispute {
  id           String      @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     User        @relation("DisputesRaised", fields: [raisedById], references: [id])
  reason       String
  description  String?
  status       String      @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, CLOSED
  resolution   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ChatThread {
  id            String   @id @default(cuid())
  jobRequestId  String?
  jobRequest    JobRequest? @relation(fields: [jobRequestId], references: [id])
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  User[]
  messages      ChatMessage[]
}

model ChatMessage {
  id         String      @id @default(cuid())
  threadId   String
  thread     ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  text       String
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([threadId])
}

model ServicePackage {
  id               String      @id @default(cuid())
  name             String
  description      String?
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  includedFeatures String[]    @default([])
  indicativePrice  String?
  iconName         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model SubscriptionPlan {
  id           String      @id @default(cuid())
  name         String
  description  String?
  categoryId   String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  frequency    String?
  pricePerTerm String?
  benefits     String[]    @default([])
  iconName     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Property {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // e.g., "Single Family", "Apartment", "Commercial"
  streetAddress String
  city          String
  state         String?
  country       String
  postalCode    String
  squareFeet    Int?
  builtYear     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets        Asset[]
  recurringJobs RecurringJob[]
}

model Asset {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String    // e.g., "HVAC Unit", "Water Heater", "Refrigerator"
  category     String    // e.g., "Appliance", "System", "Structural"
  make         String?
  model        String?
  serialNumber String?
  installDate  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warranties   Warranty[]
}

model Warranty {
  id             String    @id @default(cuid())
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider       String
  policyNumber   String?
  expirationDate DateTime
  coverageDetails String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RecurringJob {
  id               String   @id @default(cuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id])
  frequency        String   // e.g., "WEEKLY", "MONTHLY", "QUARTERLY", "YEARLY"
  nextExecutionDate DateTime
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
